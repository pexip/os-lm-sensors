From c2df8a4183940e4f32acef01cbc54204db3bfd99 Mon Sep 17 00:00:00 2001
From: Aurelien Jarno <aurel32@debian.org>
Date: Tue, 25 May 2010 11:33:23 +0200
Subject: [PATCH] fancontrol: Add --check option to only check configuration
 syntax

References: https://bugs.debian.org/cgi-bin/bugreport.cgi?bug=582979
---
 prog/pwm/fancontrol | 11 +++++++++++
 1 file changed, 11 insertions(+)

diff --git a/prog/pwm/fancontrol b/prog/pwm/fancontrol
index 243e1a8e..bfceffb6 100755
--- a/prog/pwm/fancontrol
+++ b/prog/pwm/fancontrol
@@ -390,6 +390,17 @@ function CheckFiles
 	return $outdated
 }
 
+if [ "$1" == "--check" ]
+then
+	if [ -f "$2" ]
+	then
+		LoadConfig $2
+	else
+		LoadConfig /etc/fancontrol
+	fi
+	exit 0
+fi
+
 if [ -f "$1" ]
 then
 	LoadConfig $1
-- 
2.47.2

